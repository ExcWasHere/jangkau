# Salin ke `.dev.vars` lalu isi. JANGAN commit `.dev.vars`.
# Ambil dari Supabase → Project Settings → API.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare R2 (dashboard → R2 → Manage API Tokens)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL="jangkau-media"

# Midtrans sandbox (dashboard.midtrans.com → Settings → Access Keys)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# AI: endpoint kompatibel [OI] (inferhub), model default ag/gemini-3.8-flash-high
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

APP_BASE_URL="http://localhost:5173"

# Origin tambahan yang diizinkan CORS, dipisah koma (opsional).
# URL Pages produksi sebaiknya diisi juga di APP_BASE_URL.
ALLOWED_ORIGINS=""
