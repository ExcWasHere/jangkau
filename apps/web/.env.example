# Salin ke `apps/web/.env`. Nilai VITE_* terlihat oleh browser — jangan
# pernah taruh service_role key atau AI key di sini.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Frontend (Pages) dan backend (Worker) beda origin, jadi URL-nya MUTLAK —
# jangan path relatif seperti "/api/v1".
# Lokal: http://localhost:8787/api/v1
# Produksi: https://jangkau-api.<subdomain-akun>.workers.dev/api/v1
VITE_API_BASE_URL="http://localhost:8787/api/v1"
