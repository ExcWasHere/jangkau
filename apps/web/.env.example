# Salin ke `apps/web/.env`. Nilai VITE_* terlihat oleh browser — jangan
# pernah taruh service_role key atau AI key di sini.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Lokal: API berjalan terpisah di port 8787.
# Produksi: biarkan "/api/v1" karena API dipasang di origin yang sama.
VITE_API_BASE_URL="http://localhost:8787/api/v1"
